Warehouse = {}
def receive_shipment(car_model, quantity):
    Warehouse[car_model] = quantity
receive_shipment("Supra", 8)
receive_shipment("M4", 4)
while True:
    print("Menu:   ")
    Question = input("(R)eceive Shipment, (V)iew inventory or (Q)uit?... ").lower().capitalize()
    if Question == "Q" or Question == "Quit":
        print("Goodbye then!... ")
        break
    elif Question == "R" or Question == "Receive" or Question == "Receive Shipment":
        carmodel = input("What car model arrived?... ").lower().capitalize()
        Quantity = int(input(f"How many {carmodel}'s arrived?... "))
        receive_shipment(carmodel, Quantity)
        print(f"{Quantity} {carmodel}'s added!!!... ")
    elif Question == "V" or Question == "View" or Question == "View inventory":
        for car in Warehouse:
            print(f"We have {Warehouse[car]} {car}'s in our warehouse!!!")
